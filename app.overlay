/ {
    chosen {
        zephyr,uart-mcumgr = &cdc_acm_uart0;
        zigbee,uart = &cdc_acm_uart0;
    };

    leds {
        compatible = "gpio-leds";
        blue_led: led_0 {
            gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
            label = "Blue LED";
        };
    };

    aliases {
        led0 = &blue_led;
    };
};

&usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";

    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};
